---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
---

<BaseLayout
  title="Red de instaladores | Únete como técnico"
  description="En T&V Servicios buscamos profesionales de confianza para unirse a nuestra red. Rellena el formulario y nos pondremos en contacto contigo."
  canonicalPath="/red-instaladores"
>
  <Header />

  <main class="bg-slate-50">
    <section class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
        <div class="max-w-3xl">
          <h1 class="text-balance text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            Formulario para unirse a nuestra red de instaladores
          </h1>
          <p class="mt-4 text-pretty text-slate-600">
            <span class="font-semibold text-slate-900">¿Eres técnico especializado en limpiezas de suelo radiante?</span>
            <br />
            En <span class="font-semibold">T&V SERVICIOS</span> buscamos profesionales de confianza para unirse a nuestra red.
            <br />
            👉 Rellena el formulario y nos pondremos en contacto contigo.
          </p>
        </div>

        <form
          id="instaladores-form"
          method="post"
          action="/api/instaladores"
          class="mt-10 grid gap-6"
        >
          <div class="grid gap-5 md:grid-cols-2">
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Dirección Email empresa</label>
              <input
                name="emailEmpresa"
                type="email"
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="empresa@dominio.com"
              />
            </div>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Nombre *</label>
              <input
                name="nombre"
                required
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="Nombre"
                autocomplete="given-name"
              />
            </div>
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Apellidos</label>
              <input
                name="apellidos"
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="Apellidos"
                autocomplete="family-name"
              />
            </div>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Nombre de empresa *</label>
              <input
                name="nombreEmpresa"
                required
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="Nombre de empresa"
                autocomplete="organization"
              />
            </div>
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">CIF *</label>
              <input
                name="cif"
                required
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="CIF"
              />
            </div>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <div class="text-sm font-semibold text-slate-900">Dirección empresa</div>

            <div class="mt-4 grid gap-5 md:grid-cols-2">
              <div class="grid gap-2 md:col-span-2">
                <label class="text-sm font-semibold text-slate-900">Dirección (línea 1) *</label>
                <input
                  name="direccion1"
                  required
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="Dirección (línea 1)"
                  autocomplete="address-line1"
                />
              </div>
              <div class="grid gap-2 md:col-span-2">
                <label class="text-sm font-semibold text-slate-900">Dirección 2</label>
                <input
                  name="direccion2"
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="Dirección 2"
                  autocomplete="address-line2"
                />
              </div>
              <div class="grid gap-2">
                <label class="text-sm font-semibold text-slate-900">Ciudad *</label>
                <input
                  name="ciudad"
                  required
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="Ciudad"
                  autocomplete="address-level2"
                />
              </div>
              <div class="grid gap-2">
                <label class="text-sm font-semibold text-slate-900">State / Province / Region *</label>
                <input
                  name="region"
                  required
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="State / Province / Region"
                  autocomplete="address-level1"
                />
              </div>
              <div class="grid gap-2">
                <label class="text-sm font-semibold text-slate-900">Postal Code *</label>
                <input
                  name="codigoPostal"
                  required
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="Postal Code"
                  autocomplete="postal-code"
                />
              </div>
              <div class="grid gap-2">
                <label class="text-sm font-semibold text-slate-900">País *</label>
                <select
                  name="pais"
                  required
                  class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  autocomplete="country-name"
                >
                  <option value="">--- Select country ---</option>
                  <option value="Spain" selected>Spain</option>
                  <option value="Portugal">Portugal</option>
                  <option value="France">France</option>
                  <option value="Andorra">Andorra</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Teléfono *</label>
              <div class="flex gap-3">
                <div class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-700">
                  Spain +34
                </div>
                <input
                  name="telefono"
                  required
                  class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                  placeholder="612 34 56 78"
                  autocomplete="tel"
                />
              </div>
            </div>
            <div class="grid gap-2">
              <label class="text-sm font-semibold text-slate-900">Email *</label>
              <input
                name="email"
                type="email"
                required
                class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-[var(--color-brand-blue-600)]"
                placeholder="Email"
                autocomplete="email"
              />
            </div>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-500">
              Al enviar este formulario, aceptas el tratamiento de tus datos para gestionar tu solicitud.
            </p>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--color-brand-orange-600)] px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-[var(--color-brand-orange-500)]"
            >
              Enviar solicitud
            </button>
          </div>

          <div id="instaladores-feedback" class="hidden rounded-2xl border border-slate-200 bg-white p-4 text-sm"></div>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('instaladores-form');
    const box = document.getElementById('instaladores-feedback');
    if (form && box) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        box.className = 'rounded-2xl border border-slate-200 bg-white p-4 text-sm';
        box.textContent = 'Enviando…';
        try {
          const res = await fetch(form.getAttribute('action') || '/api/instaladores', {
            method: 'POST',
            body: new FormData(form)
          });
          if (!res.ok) throw new Error(await res.text());
          const data = await res.json();
          box.className = 'rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900';
          box.textContent = `Solicitud enviada. Referencia: ${data.applicationId}`;
          form.reset();
        } catch (err) {
          box.className = 'rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800';
          box.textContent = 'No se pudo enviar la solicitud. Revisa los datos e inténtalo de nuevo.';
        }
      });
    }
  </script>
</BaseLayout>

