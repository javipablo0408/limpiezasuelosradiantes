# Copia a .env o .env.local y reinicia "npm run dev".

# --- Supabase (panel + login en el navegador) ---
# Estas dos SÍ van con NEXT_PUBLIC_: el cliente JS necesita URL y clave "anon".
# La clave anon NO es un secreto (Supabase la pensó para apps públicas); lo sensible
# es RLS en tablas y NO subir nunca la service_role al front.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (APIs, scripts); sin prefijo público:
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (emails) ---
RESEND_API_KEY=
FROM_EMAIL="TSV Servicios <consultas@limpiezasuelosradiantes.com>"
ADMIN_EMAIL="consultas@limpiezasuelosradiantes.com"

# --- Legacy ---
ADMIN_USER="admin"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# --- Google Calendar (opcional) ---
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_TIMEZONE="Europe/Madrid"
